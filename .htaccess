# build.php is CLI-only and db.inc.php is an include: neither should be
# reachable over the web. build.php also refuses to run outside the CLI.
#
# This rule works under mod_php or a SetHandler-based PHP-FPM setup. It does
# NOT apply if PHP is wired up with ProxyPassMatch (Apache never reads
# .htaccess for those requests); there, deny these in the vhost, e.g.
#   <LocationMatch "^/costindexmap/(build|db\.inc)\.php">
#       Require all denied
#   </LocationMatch>
<FilesMatch "^(build\.php|db\.inc\.php)$">
    Require all denied
</FilesMatch>

# Data files are already gzip-compressed (the page decompresses them itself).
<FilesMatch "\.bin$">
    SetEnv no-gzip 1
</FilesMatch>
# Year files have a content hash in their name, so they never change.
<FilesMatch "^ci-.+-[0-9a-f]+\.bin$">
    Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
# meta.bin is requested as meta.bin?v=<build time>.
<Files "meta.bin">
    Header set Cache-Control "public, max-age=86400"
</Files>
